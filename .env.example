# Gemini API Key (Required for Gemma 4 AI Roadmap generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (Default: gemma-2-27b-it or gemini-2.5-flash)
GEMINI_MODEL=gemma-2-27b-it

# Server Port
PORT=5001

# Firebase project configuration (Optional / standard setup)
FIREBASE_PROJECT_ID=skillpath-ai-hackathon
